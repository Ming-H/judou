# 句读环境变量（自部署 v0.1 全部可选，零配置可跑——AI 解读除外）
# 文档存储目录（PDF 与 manifest），默认 ./data
# JUDOU_DATA_DIR=./data

# ---- AI 解读（速览/问答）。任何 OpenAI 兼容端点均可，默认智谱 GLM ----
# LLM_API_KEY=your-key      # 也可复用环境变量 GLM_API_KEY / ANTHROPIC_AUTH_TOKEN
# LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-5.1

# ---- 以下为云版(M4)预留，自部署无需配置 ----
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# 平台默认 LLM（GLM）；用户 BYOK 存于 Supabase Vault
# LLM_API_BASE=
# LLM_API_KEY=
